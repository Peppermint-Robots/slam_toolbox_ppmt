# Render a serialized pose graph to a map image + yaml, as map_rasterizer does.
# Served by map_rasterizer_server as map_rasterizer/rasterize.

string posegraph          # basename, without the .posegraph/.data suffix
string output             # basename, without extension; written atomically
float64 resolution        # metres per cell
string format             # "png" or "pgm"
float64 free_thresh       # 0-1
float64 occupied_thresh   # 0-1
---
# Result code definitions
uint8 RESULT_SUCCESS=0
uint8 RESULT_BUSY=1               # a render is already running; try again later
uint8 RESULT_INVALID_REQUEST=2
uint8 RESULT_LOAD_FAILED=3        # .posegraph/.data missing, unreadable or corrupt
uint8 RESULT_OUT_OF_MEMORY=4
uint8 RESULT_RASTER_FAILED=5
uint8 RESULT_WRITE_FAILED=6

uint8 result
string message

# Filled on success
uint32 width              # rendered image width (pixels)
uint32 height             # rendered image height (pixels)
uint32 scans              # scans in the pose graph that were rastered
float64 deserialize_s     # seconds loading .posegraph + .data
float64 raster_s          # seconds ray-tracing the scans into the grid
float64 write_s           # seconds writing the image + yaml
